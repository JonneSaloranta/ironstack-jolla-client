import QtQuick 2.0
import Sailfish.Silica 1.0
import "../components"
import "../js/store.js" as Store

// Diet plans, like the web's list: the active one marked, each with its
// daily targets. A new plan is generated by IronStack's diet builder.
Page {
    id: page

    property var plans: []
    property bool loading: false
    property string errorText: ""

    function load(keepError) {
        loading = true
        var found = []
        Store.fetchAll(api, "diet-plans/?page_size=100", function(results) {
            found = found.concat(results)
        }, function(ok, error) {
            loading = false
            errorText = ok ? (keepError || "") : error
            if (ok)
                plans = found
        })
    }

    Component.onCompleted: load()
    onStatusChanged: {
        if (status === PageStatus.Active && Store.dietPlansChanged) {
            Store.dietPlansChanged = false
            load()
        }
    }

    SilicaListView {
        id: list
        anchors.fill: parent
        model: page.plans

        PullDownMenu {
            busy: page.loading
            MenuItem {
                text: qsTr("New diet plan")
                onClicked: {
                    var dialog = pageStack.push(Qt.resolvedUrl("DietPlanDialog.qml"))
                    dialog.accepted.connect(function() {
                        page.loading = true
                        api.request("POST", "diet-plans/", dialog.body(), function(ok, status, data, error) {
                            if (!ok)
                                return page.load(error)
                            page.load()
                            Store.whenIdle(pageStack, function() { pageStack.push(Qt.resolvedUrl("DietPlanPage.qml"), { planId: data.id }) })
                        })
                    })
                }
            }
        }

        header: Column {
            width: parent.width
            PageHeader {
                title: qsTr("Diet plans")
            }
            ErrorBanner {
                text: page.errorText
                showRetry: true
                onRetry: page.load()
            }
        }

        delegate: ListItem {
            contentHeight: Math.max(Theme.itemSizeSmall, textColumn.height + 2 * Theme.paddingSmall)
            onClicked: pageStack.push(Qt.resolvedUrl("DietPlanPage.qml"), { planId: modelData.id })
            Column {
                id: textColumn
                anchors.verticalCenter: parent.verticalCenter
                x: Theme.horizontalPageMargin
                width: parent.width - 2 * Theme.horizontalPageMargin
                Label {
                    width: parent.width
                    truncationMode: TruncationMode.Fade
                    color: modelData.is_active ? Theme.highlightColor : Theme.primaryColor
                    text: modelData.name + (modelData.is_active ? " · " + qsTr("Active") : "")
                }
                Label {
                    width: parent.width
                    truncationMode: TruncationMode.Fade
                    font.pixelSize: Theme.fontSizeExtraSmall
                    color: Theme.secondaryColor
                    text: modelData.target_calories + " kcal · " + qsTr("P") + " " + Math.round(parseFloat(modelData.target_protein_grams))
                          + " · " + qsTr("C") + " " + Math.round(parseFloat(modelData.target_carbohydrate_grams))
                          + " · " + qsTr("F") + " " + Math.round(parseFloat(modelData.target_fat_grams))
                          + (modelData.is_weekly ? " · " + qsTr("Weekly") : "")
                }
            }
        }

        ViewPlaceholder {
            enabled: !page.loading && page.plans.length === 0 && page.errorText === ""
            text: qsTr("No diet plans yet.")
            hintText: qsTr("Pull down to create one")
        }

        VerticalScrollDecorator {}
    }
}
